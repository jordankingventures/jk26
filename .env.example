# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore -- committen mag niet, deze gegevens zijn geheim.
# Plak je Kalshi private key hier NOOIT ergens in een chatgesprek/AI-tool --
# alleen hier, lokaal, in je eigen editor.

# "demo" om eerst te testen tegen Kalshi's sandbox, "prod" voor echt geld.
KALSHI_ENV=demo

# Kalshi -> Account Settings (https://kalshi.com/account/profile) -> API Keys
# -> "Create New API Key".
KALSHI_KEY_ID=

# De volledige inhoud van je private key (incl. de -----BEGIN/END----- regels),
# tussen dubbele aanhalingstekens zodat de regeleindes bewaard blijven:
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
plak hier de hele inhoud van je .pem-bestand
-----END RSA PRIVATE KEY-----"

# Alternatief voor KALSHI_PRIVATE_KEY: verwijs naar een los .pem-bestand op
# schijf i.p.v. de inhoud hierboven te plakken. Alleen nodig als je dat
# prefereert -- laat leeg als je KALSHI_PRIVATE_KEY hierboven al hebt ingevuld.
KALSHI_KEY_FILE=
